# EX REVIVAL - Backend Environment Variables

APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (SQLite for dev fallback, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./ex_revival.db
# PostgreSQL Example: postgresql+asyncpg://postgres:password@localhost:5432/ex_revival

# Security & JWT
JWT_SECRET=super_secret_jwt_key_ex_revival_dev_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Voice Service (Chatterbox GPU / Microservice)
VOICE_SERVICE_URL=http://localhost:8001
VOICE_ENGINE_PROVIDER=chatterbox

# STT Configuration (whisper, openai, mock)
STT_PROVIDER=mock
STT_API_KEY=your_openai_or_whisper_key_here
WHISPER_MODEL_SIZE=base

# LLM Configuration (openai, gemini, mock)
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here

# Storage (local or s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET_NAME=ex-revival-audio
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mock AI Mode (when GPU or paid cloud API keys are absent)
MOCK_AI=true
